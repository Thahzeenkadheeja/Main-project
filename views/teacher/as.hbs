<main class="main pt-5">

    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <h4 class="mt-3 mb-3">Manage Students Assignments</h4>
            {{!-- <a href="/teacher/add-hw" class="btn btn-dark">+ Add New Home Work</a> --}}
        </div>
        <div class="card">
            <div class="card-body">



                <h5 class="card-title">All Assignments</h5>



                <div class="table-responsive">
                    <!-- Table with stripped rows -->
                    <table class="table table-bordered datatable">
                        <thead>
                            <tr>
                                <th>No.</th>
                                <th>Date</th>
                                <th>Student Name</th>
                                <th>Note</th>
                                <th>Image</th>
                                {{!-- <th>Manage</th> --}}
                                {{!-- <th>Manage</th> --}}
                            </tr>
                        </thead>
                        <tbody>
                            {{#each aassignments}}
                            <tr>
                                <td>{{incremented @index}}</td>
                                <td>{{formatDate this.createdAt}}</td>
                                <td>{{this.username}}</td>
                                <td>{{this.text}}</td>

                                <td>
                                    <a href="{{this.image}}">
                                        <img src="{{this.image}}" width="50px" alt=""></a>
                                </td>

                                {{!-- <td>
                                    <a href="/teacher/delete-task/{{this._id}}" class="btn btn-danger btn-sm">Delete</a>

                                </td> --}}
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
                <!-- End Table with stripped rows -->
            </div>
        </div>
    </div>
    </div>


    <script>
        function deleteMaterial(id, wname) {
            Swal.fire({
                title: `Are you sure you want to delete "${wname}"?`,
                text: '',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#33ff68',
                cancelButtonColor: '#d29eee',
                confirmButtonText: 'Yes!',
                cancelButtonText: 'No'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Redirect to the delete route if confirmed
                    window.location.href = `/builder/delete-material/${id}`;
                }
            });
        }
    </script>