<style>
    .header {
        background-color: black !important;
    }
</style>

<main class="main pt-5">
    <div class="container">
        <br><br><br>
        <div class="pagetitle">
            <h1>My Attendance</h1>

        </div><!-- End Page Title -->

        <section id="services" class="services section">

            <div class="row">
                <div class="col-lg-12">
                    <a href="/" class="btn btn-dark btn-sm">Back</a>
                    <div class="card shadow mt-3">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table datatable table-bordered border">
                                    <thead>
                                        <tr>
                                            <th data-type="date" data-format="YYYY/DD/MM"> Date</th>
                                            <th>Period</th>
                                            <th>Class</th>
                                            <th>Subject</th>
                                            <th>Attended Stauts</th>

                                            {{!-- <th>Manage</th> --}}
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {{#each attendance}}
                                        <tr>
                                            <td>{{formatDate this.date}}</td>
                                            <td>{{this.period}}</td>
                                            <td>{{this.Class}}</td>
                                            <td>{{this.subjectName}}</td>
                                            <td>
                                                {{#if this.isPresent}}
                                                <span style="color: green;">✅ Present</span>
                                                {{else}}
                                                <span style="color: red;">❌ Absent</span>
                                                {{/if}}
                                            </td>
                                        </tr>
                                        {{/each}}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>


                </div>
            </div>
        </section>
    </div>
</main><!-- End #main -->