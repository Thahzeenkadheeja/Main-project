<style>
    .header {
        background-color: black !important;
    }
</style>

<main class="main pt-5">
    <div class="container">

        <div class="pagetitle">
            <h1>Exams</h1>

        </div><!-- End Page Title -->

        <section id="services" class="services section">

            <div class="row">
                <div class="col-lg-12">
                    <a href="/" class="btn btn-dark btn-sm">Back</a>
                    <div class="card shadow mt-3">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table datatable table-bordered border">
                                    <thead>
                                        <tr>
                                            <th>No.</th>
                                            <th>Subject Details</th>

                                            {{!-- <th data-type="date" data-format="YYYY/DD/MM"> Date</th> --}}
                                            <th data-type="date" data-format="YYYY/DD/MM"> Exam Date</th>

                                            <th>Chapter Details</th>


                                            {{!-- <th>Attended Students</th> --}}

                                        </tr>
                                    </thead>
                                    <tbody>
                                        {{#each exams}}
                                        <tr>
                                            <td>{{incremented @index}}</td>
                                            <td>
                                                <p class="mb-0"><b>Teacher : </b> {{this.teacher}}</p>
                                                <p class="mb-0"><b>Subject : </b> {{this.subject}}</p>
                                            </td>
                                            {{!-- <td>{{formatDate this.date}}</td> --}}
                                            <td class="text-danger">{{formatDate this.deadline}}</td>
                                            <td>
                                                Chapter Name : {{this.name}} <br>
                                                from : Chapter {{this.from}} <br>
                                                to : Chapter {{this.to}} <br>

                                            </td>

                                            {{!-- <td><a href="/images/task-images/{{this._id}}-1.png">
                                                    <img src="/images/task-images/{{this._id}}-1.png" width="50px"></a>
                                            </td> --}}


                                            {{!-- <td> {{#each selectedUsers}}
                                                {{this}} ,
                                                {{else}}
                                                <li>No users selected</li>
                                                {{/each}}
                                            </td> --}}

                                            {{!-- <td>
                                                <div class="">
                                                    <a href="/view-task/{{this._id}}" class="btn btn-dark btn-sm"><i
                                                            class="bi bi-pen"></i> Attend</a>
                                                    </form>
                                                </div>
                                            </td> --}}

                                        </tr>
                                        {{/each}}
                                    </tbody>
                                </table>

                            </div>

                        </div>
                    </div>


                </div>



                <div class="col-lg-12">
                    <br><br><br>

                    <h3 class="text-danger">Public Exam Time tables for class {{user.Class}}</h3> <br>

                    <div class="card p-3 shadow">
                        <div class="table-responsive">
                            <table class="table datatable border table-bordered">
                                <thead>
                                    <tr>
                                        <th>Exam Name</th>
                                        <th>Subjects</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#each publicexams}}
                                    <tr>
                                        <td>{{this.examname}}</td>
                                        <td>

                                            <table class="table border table-bordered">
                                                <thead>
                                                    <tr>
                                                        <th>Date</th>
                                                        <th>Subject</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td>{{this.d1}} </td>
                                                        <td>{{this.s1}} </td>
                                                    </tr>
                                                    <tr>
                                                        <td>{{this.d2}} </td>
                                                        <td>{{this.s2}} </td>
                                                    </tr>
                                                    <tr>
                                                        <td>{{this.d3}} </td>
                                                        <td>{{this.s3}} </td>
                                                    </tr>
                                                    <tr>
                                                        <td>{{this.d4}} </td>
                                                        <td>{{this.s4}} </td>
                                                    </tr>
                                                    <tr>
                                                        <td>{{this.d5}} </td>
                                                        <td>{{this.s5}} </td>
                                                    </tr>
                                                    <tr>
                                                        <td>{{this.d6}} </td>
                                                        <td>{{this.s6}} </td>
                                                    </tr>
                                                    <tr>
                                                        <td>{{this.d7}} </td>
                                                        <td>{{this.s7}} </td>
                                                    </tr>
                                                    <tr>
                                                        <td>{{this.d8}} </td>
                                                        <td>{{this.s8}} </td>
                                                    </tr>
                                                    <tr>

                                                </tbody>
                                            </table>



                                        </td>


                                    </tr>
                                    {{/each}}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <br><br><br>






                </div>
            </div>
        </section>
    </div>
</main><!-- End #main -->