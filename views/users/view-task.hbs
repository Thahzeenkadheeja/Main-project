<main class="main pt-5">
    <div class="container">
        <div class="row">
            <!-- Task Image Section -->
            {{!-- <div class="col-lg-6">
                <div class="card mb-4">
                    <div class="card-body text-center">
                        <a href="/images/task-images/{{task._id}}-1.png">
                            <img class="rounded img-fluid" src="/images/task-images/{{task._id}}-1.png" alt="Task Image">
                        </a>
                    </div>
                </div>
            </div> --}}
            

            <!-- Task Details Section -->
            <div class="col-lg-6">
                <div class="card shadow-lg border-0 rounded-lg mb-4 p-4">
                    <h5 class="text-primary">Chapter No. {{task.no}}</h5>
                    <h3 class="fw-bold">{{task.name}}</h3>
                    <hr>
                    <h5 class="text-secondary">Note</h5>
                    <p class="text-muted">{{task.note}}</p>
                    <hr>
                    <h5 class="text-secondary">Requirements</h5>
                    <p class="text-muted">{{task.req}}</p>
                    <hr>
                    <div class="d-grid gap-2">
                        <button class="btn btn-outline-dark fw-bold">📅 Added Date: {{formatDate task.date}}</button>
                        <button class="btn btn-outline-danger fw-bold">⏳ Deadline: {{formatDate task.deadline}}</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Assignment Submission & Status Section -->
        <div class="card shadow-lg border-0 rounded-lg p-5 mt-4">
            <div class="row g-5">
                <!-- Submission Form -->
                <div class="col-lg-4">
                    <h5 class="text-success">📤 Submit Your Assignment</h5>
                    <hr>
                    {{#if user}}
                    <form action="/add-assignment" enctype="multipart/form-data" method="post" class="bg-light p-3 rounded shadow-sm">
                        <input type="hidden" name="taskId" value="{{task._id}}">
                        <input type="hidden" name="teacherId" value="{{task.teacherId}}">
                        
                        <label class="mb-2 fw-bold">Your Name</label>
                        <input class="form-control mb-3" type="text" name="username" value="{{user.Fname}} {{user.Lname}}" readonly>

                        <label class="mb-2 fw-bold">Upload Your Assignment</label>
                        <input class="form-control mb-3" type="file" name="image">

                        <label class="mb-2 fw-bold">Any Note</label>
                        <textarea class="form-control mb-3" name="text" placeholder="Write anything..." required></textarea>
                        
                        <button type="submit" class="btn btn-success w-100 fw-bold">✅ Submit</button>
                    </form>
                    {{else}}
                    <a href="/signin" class="btn btn-warning w-100 fw-bold">🔑 Please login to submit your assignment</a>
                    {{/if}}
                </div>
                
                <!-- Assignment Status -->
                <div class="col-lg-8">
                    <h5 class="text-info">📜 Assignment Status</h5>
                    <hr>
                    <div class="feedback-section">
                        {{#each feedbacks}}
                        <div class="card border-start border-info p-3 shadow-sm mb-3">
                            <p><strong class="text-primary">{{this.username}}</strong> - Submitted on {{formatDate this.createdAt}}</p>
                        </div>
                        {{else}}
                        <p class="text-muted">🚫 No assignments submitted yet.</p>
                        {{/each}}
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const buyNowButton = document.querySelector('.buy-now');
        if (buyNowButton) {
            const seatsAvailable = parseInt(buyNowButton.getAttribute('data-seats'), 10);
            if (seatsAvailable === 0) {
                buyNowButton.disabled = true;
                buyNowButton.textContent = 'Sold Out';
                buyNowButton.classList.add('disabled');
            } else {
                buyNowButton.addEventListener('click', function () {
                    buyNow(buyNowButton.getAttribute('data-id'));
                });
            }
        }
    });

    function buyNow(taskId) {
        window.location.href = '/place-order/' + taskId;
    }

    document.querySelectorAll('.date-cell').forEach(function (cell) {
        const date = new Date(cell.textContent);
        cell.textContent = date.toLocaleDateString('en-GB', {
            day: '2-digit', month: 'short', year: 'numeric'
        }) + ' | ' + date.toLocaleTimeString('en-GB', {
            hour: '2-digit', minute: '2-digit'
        });
    });
</script>